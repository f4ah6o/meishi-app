# Local wrangler dev overrides — copy to `.dev.vars` (gitignored).
# These vars NEVER belong in a deployed environment: AUTH_MODE=dev bypasses
# Access verification and is honored only while ENVIRONMENT=local.
ENVIRONMENT=local
AUTH_MODE=dev
DEV_USER_EMAIL=dev@example.local
OPENCODE_API_KEY=
NTA_APP_ID=
GBIZINFO_API_TOKEN=
