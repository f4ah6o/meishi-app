# --- Gateway ---
PORT=8787
# Bind interface. Default 127.0.0.1 so the gateway is only reachable through
# the Cloudflare Tunnel. Only change when you know what you are doing.
HOST=127.0.0.1
MAX_IMAGE_BYTES=6291456
# ephemeral: delete captured image right after extraction (default). keep: retain for PoC debugging.
IMAGE_RETENTION=ephemeral
RATE_LIMIT_PER_MINUTE=60
# Directory served as the PWA on this origin. Default: <repo>/web/dist. off: API only.
# WEB_DIST=../web/dist

# --- Authentication ---
# access (default): verify Cloudflare Access JWT (signature + issuer + audience).
# dev: trust a fixed dev identity — LOCAL USE ONLY, set it explicitly in .env.
AUTH_MODE=dev
DEV_USER_EMAIL=dev@example.local
# Required when AUTH_MODE=access:
ACCESS_TEAM_NAME=your-team        # https://your-team.cloudflareaccess.com
ACCESS_AUD=xxxxxxxxxxxxxxxx       # Application AUD tag from the Access app config

# --- Card extraction ---
# codex (default): `codex app-server` on this host. stub: fixed response for dev/tests.
CARD_EXTRACTOR=codex
CODEX_APP_SERVER_BIN=codex
# CODEX_MODEL=                 # optional model override passed to thread/start
CODEX_TIMEOUT_MS=120000

# --- Data store ---
# memory (default): in-memory store for PoC. kintone: real kintone apps.
STORE_BACKEND=memory
KINTONE_BASE_URL=https://your-subdomain.cybozu.com
KINTONE_API_TOKEN=
KINTONE_CORPORATIONS_APP_ID=
KINTONE_CORPORATIONS_APP_TOKEN=
KINTONE_CONTACTS_APP_ID=
KINTONE_CONTACTS_APP_TOKEN=
KINTONE_CARDS_APP_ID=
KINTONE_CARDS_APP_TOKEN=
KINTONE_INTERACTIONS_APP_ID=
KINTONE_INTERACTIONS_APP_TOKEN=

# --- Public corporate registry ---
# nta (default): 国税庁 法人番号公表サイト Web-API v4. gbizinfo: gBizINFO REST API. none: disable.
CORPORATE_REGISTRY=nta
NTA_APP_ID=                        # 13-digit application id from the NTA
GBIZINFO_API_TOKEN=                # token issued by the gBizINFO site

# --- Decision layer ---
# rule (default): deterministic scorer. jev: HTTP decision endpoint adapter.
DECISION_PROVIDER=rule
JEV_ENDPOINT=
JEV_API_KEY=

# --- Cloudflare Worker (worker/) ---
# The Worker reads its config from wrangler.toml [vars] + secrets, not .env.
# Defaults (already in wrangler.toml):
#   ENVIRONMENT=production  OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
#   OPENCODE_MODEL=deepseek-v4-flash-vision-exp  OPENCODE_TIMEOUT_MS=60000
#   CORPORATE_REGISTRY=nta  DECISION_PROVIDER=rule
#   ACCESS_TEAM_NAME=f4ah6o  ACCESS_AUD=<bound app AUD>   # public config, in wrangler.toml
# Set at deploy time:
#   wrangler deploy                                      # ACCESS_* vars ship with the deploy
#   wrangler secret put OPENCODE_API_KEY     # OpenCode Zen Go key (required for /api/cards/analyze)
#   wrangler secret put GBIZINFO_API_TOKEN   # only when CORPORATE_REGISTRY=gbizinfo
# Local dev only (worker/.dev.vars, copied from .dev.vars.example):
#   ENVIRONMENT=local AUTH_MODE=dev DEV_USER_EMAIL=dev@example.local
