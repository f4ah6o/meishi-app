# --- Gateway ---
PORT=8787
MAX_IMAGE_BYTES=6291456
# ephemeral: delete captured image right after extraction (default). keep: retain for PoC debugging.
IMAGE_RETENTION=ephemeral
RATE_LIMIT_PER_MINUTE=60

# --- Authentication ---
# dev: trust a fixed dev identity (local use only). access: verify Cloudflare Access JWT.
AUTH_MODE=dev
DEV_USER_EMAIL=dev@example.local
# Required when AUTH_MODE=access:
ACCESS_TEAM_NAME=your-team        # https://your-team.cloudflareaccess.com
ACCESS_AUD=xxxxxxxxxxxxxxxx       # Application AUD tag from the Access app config

# --- Card extraction ---
# codex (default): `codex app-server` on this host. stub: fixed response for dev/tests.
CARD_EXTRACTOR=codex
CODEX_APP_SERVER_BIN=codex
# CODEX_MODEL=                 # optional model override passed to thread/start
CODEX_TIMEOUT_MS=120000

# --- Data store ---
# memory (default): in-memory store for PoC. kintone: real kintone apps.
STORE_BACKEND=memory
KINTONE_BASE_URL=https://your-subdomain.cybozu.com
KINTONE_API_TOKEN=
KINTONE_CORPORATIONS_APP_ID=
KINTONE_CORPORATIONS_APP_TOKEN=
KINTONE_CONTACTS_APP_ID=
KINTONE_CONTACTS_APP_TOKEN=
KINTONE_CARDS_APP_ID=
KINTONE_CARDS_APP_TOKEN=
KINTONE_INTERACTIONS_APP_ID=
KINTONE_INTERACTIONS_APP_TOKEN=

# --- Public corporate registry ---
# nta (default): 国税庁 法人番号公表サイト Web-API v4. gbizinfo: gBizINFO REST API. none: disable.
CORPORATE_REGISTRY=nta
NTA_APP_ID=                        # 13-digit application id from the NTA
GBIZINFO_API_TOKEN=                # token issued by the gBizINFO site

# --- Decision layer ---
# rule (default): deterministic scorer. jev: HTTP decision endpoint adapter.
DECISION_PROVIDER=rule
JEV_ENDPOINT=
JEV_API_KEY=
