{
  "name": "meishi-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web",
    "worker"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @meishi/server\" \"npm run dev -w @meishi/web\"",
    "dev:server": "npm run dev -w @meishi/server",
    "dev:web": "npm run dev -w @meishi/web",
    "build": "npm run build -w @meishi/web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "npm run typecheck -w @meishi/server && npm run typecheck -w @meishi/web && npm run typecheck -w @meishi/worker",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260921.1": true,
    "workerd@1.20260730.1": true
  }
}
